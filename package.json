    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/node": "^26.6.5",
    "standardwebhooks": "^1.1.1",
    "typescript": "^7.0.2"
  }
}
