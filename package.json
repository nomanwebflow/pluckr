{
  "name": "pluckr-image-extractor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:apps-script": "vite build && node scripts/build-apps-script.mjs",
