{
  "name": "pluckr-image-extractor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite addon",
    "build": "vite build addon",
    "build:apps-script": "npm run build && node addon/scripts/build-apps-script.mjs",
    "preview": "vite preview addon",
    "push": "npm run build:apps-script && clasp push --force",
    "test:features": "node addon/scripts/test-features.mjs",
    "test:paid": "node --experimental-strip-types --no-warnings addon/scripts/test-convex-crypto.mjs && node --experimental-strip-types --no-warnings addon/scripts/test-addon-gate.mjs",
    "site:build": "node marketing/scripts/build-site.mjs",
    "site:deploy": "marketing/scripts/deploy-site.sh"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@vitejs/plugin-react": "latest",
    "convex": "^1.47.0",
    "fflate": "^0.8.3",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1",
    "standardwebhooks": "^1.1.1",
    "typescript": "^7.0.2"
  }
}
